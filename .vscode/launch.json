{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Web - Helium)",
      "request": "launch",
      "type": "dart",
      "deviceId": "chrome",
      "cwd": "${workspaceFolder}/pas_mobiledev",
      "program": "${workspaceFolder}/pas_mobiledev/lib/main.dart",
      "args": [
        "--web-browser-flag=--disable-web-security",
        "--web-browser-flag=--user-data-dir=/tmp/chrome_dev_helium"
      ]
    },
        {
            "name": "pas_mobiledev (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "pas_mobiledev (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}